# Commercial platform token (https://api.synack.com)
SYNACK_TOKEN=your_commercial_bearer_token_here

# FedRAMP platform token (https://api.synack.us)
SYNACK_FEDRAMP_TOKEN=your_fedramp_bearer_token_here

# Organization UID (used by both platforms unless overridden per watch_dir)
SYNACK_ORG_UID=your_organization_uid_here
